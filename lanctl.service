[Unit]
Description=lanctl — LAN host control
Documentation=https://github.com/tkdlabs/lanctl
After=network.target

[Service]
Type=simple
User=@RUN_USER@
WorkingDirectory=@DEPLOY_DIR@
EnvironmentFile=@DEPLOY_DIR@/.env
ExecStart=@DEPLOY_DIR@/lanctl
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
